#!/bin/sh
# tt — per-project time tracking across machines and agent harnesses.
set -u

TT_HOME=${TT_HOME:-$HOME/.timetrack}
TT_ROOT=${TT_ROOT:-$HOME/workspace}
TT_IDLE_GAP=${TT_IDLE_GAP:-1800}
TT_READING_WPM_SET=${TT_READING_WPM+x}
TT_MAX_READING_TIME_SET=${TT_MAX_READING_TIME+x}
TT_MAX_ACTIVE_GAP_SET=${TT_MAX_ACTIVE_GAP+x}
TT_READING_WPM=${TT_READING_WPM:-120}
TT_MAX_READING_TIME=${TT_MAX_READING_TIME:-600}
TT_MAX_ACTIVE_GAP=${TT_MAX_ACTIVE_GAP:-3600}

tt_die() { printf 'tt: %s\n' "$1" >&2; exit 1; }

# Config is a flat key=value file. Values already in the environment win.
tt_config() { # key
  [ -f "$TT_HOME/config" ] || return 1
  sed -n 's/^'"$1"'=\(.*\)$/\1/p' "$TT_HOME/config" | head -1
}

tt_home() { printf '%s\n' "$TT_HOME"; }

tt_root() {
  v=$(tt_config TT_ROOT) || v=''
  [ -n "${v:-}" ] && [ "$TT_ROOT" = "$HOME/workspace" ] && TT_ROOT=$v
  # Attribution matches "$root"/* against a path already normalised by tt_abs,
  # so a root written with a trailing or doubled slash would match nothing and
  # attribute every project to ~outside. One character in a config file otherwise
  # costs the whole log its attribution.
  TT_ROOT=$(printf '%s' "$TT_ROOT" | sed 's://*:/:g; s:/*$::')
  [ -n "$TT_ROOT" ] || TT_ROOT=/
  printf '%s\n' "$TT_ROOT"
}

tt_now() { printf '%s\n' "${TT_NOW:-$(date +%s)}"; }

tt_machine() {
  v=$(tt_config machine) || v=''
  if [ -n "${v:-}" ]; then printf '%s\n' "$v"
  else hostname 2>/dev/null | sed 's/\..*//' | tr -c 'A-Za-z0-9-' '-' | sed 's/-*$//'
  fi
}

# BSD date first, GNU second. Both are tried; whichever parses wins.
tt_iso() { # epoch
  date -r "$1" +'%Y-%m-%dT%H:%M:%S%z' 2>/dev/null \
    || date -d "@$1" +'%Y-%m-%dT%H:%M:%S%z' 2>/dev/null \
    || tt_die "cannot format epoch $1"
}

tt_epoch() { # 'YYYY-MM-DD HH:MM'
  date -j -f '%Y-%m-%d %H:%M' "$1" +%s 2>/dev/null \
    || date -d "$1" +%s 2>/dev/null \
    || tt_die "cannot parse time: $1"
}

tt_fmt() { # epoch format
  date -r "$1" +"$2" 2>/dev/null || date -d "@$1" +"$2" 2>/dev/null \
    || tt_die "cannot format epoch $1"
}

tt_compact_file() { printf '%s/events-%s.tsv\n' "$TT_HOME" "$(tt_machine)"; }
tt_current_file() { printf '%s/current-%s.tsv\n' "$TT_HOME" "$(tt_machine)"; }

# New detail is written here. Completed local days are reduced into the
# companion events file by tt_compact_locked.
tt_log_file() { tt_current_file; }

# Absolute path without requiring realpath, which macOS lacks by default.
tt_abs() { # path
  d=$1
  [ -d "$d" ] && { (cd "$d" 2>/dev/null && pwd) && return 0; }
  case "$d" in
    /*) printf '%s\n' "$d" | sed 's://*:/:g; s:/$::' ;;
    *)  printf '%s\n' "$PWD/$d" | sed 's://*:/:g; s:/$::' ;;
  esac
}

# Resolves $0 through any symlinks without readlink -f, which macOS lacks.
tt_self() {
  s=$0
  while [ -L "$s" ]; do
    d=$(cd "$(dirname "$s")" && pwd)
    l=$(readlink "$s")
    case "$l" in /*) s=$l ;; *) s="$d/$l" ;; esac
  done
  (cd "$(dirname "$s")" && pwd)
}

tt_attribute() { # abs-path -> project<TAB>subpath
  p=$(tt_abs "$1")
  r=$(tt_root)
  if [ "$p" = "$r" ]; then printf '~root\t.\n'; return; fi
  case "$p" in
    "$r"/*)
      rest=${p#"$r"/}
      proj=${rest%%/*}
      sub=${rest#"$proj"}
      sub=${sub#/}
      [ -n "$sub" ] || sub='.'
      printf '%s\t%s\n' "$proj" "$sub" ;;
    *) printf '~outside\t%s\n' "$p" ;;
  esac
}

# Current modes are a capture-time cache. Each row is
# mode<TAB>abspath<TAB>session, where session '-' means every session below the
# path. Rows are ordered by their last explicit transition, so the latest
# matching ancestor wins. The durable transition itself is also appended to the
# event log; this file only lets a hook stamp its beat without scanning history.
tt_modes_file() { printf '%s/modes\n' "$TT_HOME"; }

tt_mode() { # abs-path [session] -> paired|solo
  p=$(tt_abs "$1")
  s=${2:--}
  f=$(tt_modes_file)
  [ -f "$f" ] || { printf 'paired\n'; return; }
  m=$(TT_MODE_PATH=$p TT_MODE_SESSION=$s awk -F '\t' '
    BEGIN { p = ENVIRON["TT_MODE_PATH"]; session = ENVIRON["TT_MODE_SESSION"] }
    function contains(scope, path) {
      return path == scope || index(path, scope "/") == 1
    }
    NF >= 2 {
      row_session = (NF >= 3 && $3 != "" ? $3 : "-")
      if ((row_session == "-" || row_session == session) && contains($2, p))
        v = $1
    }
    END { if (v != "") print v }
  ' "$f")
  [ -n "${m:-}" ] || m=paired
  printf '%s\n' "$m"
}

# mkdir either creates the directory or fails, atomically, on every POSIX
# filesystem -- and unlike flock it exists on macOS. Held only across the
# read-modify-write below, which is one awk and one mv, so contention clears in
# milliseconds. Each retry is itself a fork, which paces the spin; only a lock
# held far longer than any real write reaches the sleep, and a lock left behind
# by a killed process is refused rather than waited on forever.
tt_lock_dir() { printf '%s/modes.lock\n' "$TT_HOME"; }

tt_lock() {
  d=$(tt_lock_dir)
  i=0
  while ! mkdir "$d" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -lt 200 ] || sleep 1
    [ "$i" -lt 210 ] || return 1
  done
  return 0
}

tt_unlock() { rmdir "$(tt_lock_dir)" 2>/dev/null || :; }

tt_event_lock_dir() { printf '%s/events-%s.lock\n' "$TT_HOME" "$(tt_machine)"; }

tt_event_lock() {
  d=$(tt_event_lock_dir)
  i=0
  while ! mkdir "$d" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -lt 200 ] || sleep 1
    [ "$i" -lt 210 ] || return 1
  done
  return 0
}

tt_event_unlock() { rmdir "$(tt_event_lock_dir)" 2>/dev/null || :; }

# Appends the durable record of a mode transition, shared by an explicit
# `tt solo`/`tt paired` and an automatic trigger detected in cmd_hook. ORIGIN
# lands in column 11, which a mode row otherwise leaves empty, so a session
# that went solo on its own can be explained later; nothing in reporting
# reads it.
tt_write_mode_row() { # mode path session epoch origin
  wmr_mode=$1
  wmr_path=$2
  wmr_session=$3
  wmr_epoch=$4
  wmr_origin=${5:--}
  wmr_attrib=$(tt_attribute "$wmr_path")
  wmr_proj=$(printf '%s' "$wmr_attrib" | cut -f1)
  wmr_sub=$(printf '%s' "$wmr_attrib" | cut -f2)
  wmr_row=$(printf '%s\tmode\t%s\t%s\t%s\t-\t%s\t%s\t%s\t%s\t%s' \
    "$(tt_iso "$wmr_epoch")" "$wmr_epoch" "$wmr_epoch" "$(tt_machine)" "$wmr_mode" \
    "$(tt_clean "$wmr_proj")" "$(tt_clean "$wmr_sub")" "$(tt_clean "$wmr_session")" \
    "$(tt_clean "$wmr_origin")")
  tt_append_row "$wmr_row" "$wmr_epoch"
}

# Rewrites the capture-time mode cache read by tt_mode, so a hook can stamp
# its very next beat with a transition instead of waiting for a report to
# replay the durable mode row tt_write_mode_row appends alongside it. Shared
# by an explicit `tt solo`/`tt paired` and an automatic trigger in cmd_hook.
#
# Failure is signalled by a plain return, never tt_die: cmd_hook calls this
# directly (not inside a subshell of its own), and an automatic trigger must
# degrade quietly rather than abort the rest of the hook -- ordinary lock
# contention between concurrent hooks is expected, not an error worth dying
# over. tt_set_mode, called only for an explicit `tt solo`/`tt paired`, is
# the one that turns a failure here into a visible one.
tt_cache_mode() { # mode path session
  cm_mode=$1
  cm_path=$(tt_abs "$2")
  cm_session=$3
  # The modes file separates its fields with a TAB and its rows with a
  # newline, so a path holding either cannot be stored and read back as itself.
  # Refusing it costs two comparisons; an escaping scheme would cost a format.
  tab=$(printf '\t')
  nl=$(printf '\nx'); nl=${nl%x}
  case "$cm_path" in
    *"$tab"*) return 1 ;;
    *"$nl"*)  return 1 ;;
  esac
  case "$cm_session" in
    *"$tab"*) return 1 ;;
    *"$nl"*)  return 1 ;;
    '')        return 1 ;;
  esac
  mkdir -p "$TT_HOME" || return 1
  tt_lock || return 1
  trap 'tt_unlock' EXIT HUP INT TERM
  f=$(tt_modes_file)
  if [ -f "$f" ]; then src=$f; else src=/dev/null; fi
  # Rewritten whole into a temporary file and moved into place, so a reader
  # racing this sees either the old file or the new one, never half of either.
  t="$f.$$"
  if TT_MODE=$cm_mode TT_MODE_PATH=$cm_path TT_MODE_SESSION=$cm_session awk -F '\t' '
    BEGIN {
      m = ENVIRON["TT_MODE"]; p = ENVIRON["TT_MODE_PATH"]
      session = ENVIRON["TT_MODE_SESSION"]
    }
    NF >= 2 {
      row_session = (NF >= 3 && $3 != "" ? $3 : "-")
      if ($2 == p && row_session == session) next
      printf "%s\t%s\t%s\n", $1, $2, row_session
    }
    END { printf "%s\t%s\t%s\n", m, p, session }
  ' "$src" > "$t"
  then
    mv "$t" "$f" || { rm -f "$t"; tt_unlock; trap - EXIT HUP INT TERM; return 1; }
  else
    rm -f "$t"; tt_unlock; trap - EXIT HUP INT TERM; return 1
  fi
  tt_unlock
  trap - EXIT HUP INT TERM
  return 0
}

tt_set_mode() { # mode path session [quiet]
  m=$1
  p=$(tt_abs "${2:-$PWD}")
  s=${3:--}
  tt_cache_mode "$m" "$p" "$s" || tt_die "cannot record mode: $m $p (session $s); check for a tab or newline in the path or session, or that $(tt_modes_file) is writable"

  # The explicit transition is the source of truth for reports. Unlike a mode
  # stamped on the next hook beat, it splits activity at the instant the user
  # says they stepped away or returned.
  now=$(tt_now)
  tt_write_mode_row "$m" "$p" "$s" "$now" hand || tt_die "cannot record mode transition in $(tt_log_file)"

  [ "${4:-}" = quiet ] || {
    if [ "$s" = - ]; then printf '%s: %s (all sessions below path)\n' "$m" "$p"
    else printf '%s: %s (session %s)\n' "$m" "$p" "$s"
    fi
  }
}

cmd_mode() { # paired|solo [path] [--session id|--all-sessions]
  mode_command=$1
  shift
  mode_path=$PWD
  mode_path_seen=0
  # Codex exports its hook session id into in-session shell commands. Claude
  # builds have used either of the names below; when none is present this is an
  # ordinary external terminal and the command intentionally scopes by path.
  if [ -n "${TT_SESSION_ID:-}" ]; then mode_session=$TT_SESSION_ID
  elif [ -n "${CODEX_SESSION_ID:-}" ]; then mode_session=$CODEX_SESSION_ID
  elif [ -n "${CODEX_THREAD_ID:-}" ]; then mode_session=$CODEX_THREAD_ID
  elif [ -n "${CLAUDE_SESSION_ID:-}" ]; then mode_session=$CLAUDE_SESSION_ID
  elif [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then mode_session=$CLAUDE_CODE_SESSION_ID
  else mode_session=-
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --session)
        [ $# -ge 2 ] || tt_die "--session needs an id"
        mode_session=$2
        shift 2 ;;
      --session=*)
        mode_session=${1#--session=}
        [ -n "$mode_session" ] || tt_die "--session needs an id"
        shift ;;
      --all-sessions)
        mode_session=-
        shift ;;
      -*) tt_die "usage: tt $mode_command [PATH] [--session ID|--all-sessions]" ;;
      *)
        [ "$mode_path_seen" -eq 0 ] || tt_die "usage: tt $mode_command [PATH] [--session ID|--all-sessions]"
        mode_path=$1
        mode_path_seen=1
        shift ;;
    esac
  done
  tt_set_mode "$mode_command" "$mode_path" "$mode_session"
}

# Extracts a top-level JSON string field. A hook payload embeds the whole tool
# input, which can carry its own "cwd" key, and paths can hold commas, colons,
# braces and escaped quotes -- so this scans the text rather than matching it,
# tracking string state and nesting depth, and only accepts a key at depth 1 of
# the outermost object. Escapes are left as written; these fields are paths and
# ids, and nothing downstream decodes them.
tt_json_str() { # field json
  printf '%s' "$2" | awk -v key="$1" '
    { buf = buf $0 "\n" }
    END {
      n = length(buf)
      depth = 0
      i = 1
      while (i <= n) {
        c = substr(buf, i, 1)
        if (c == "{" || c == "[") { depth++; stack[depth] = c; i++; continue }
        if (c == "}" || c == "]") { if (depth > 0) depth--; i++; continue }
        if (c != "\"") { i++; continue }

        # Walk the string token without copying it; j lands on its closing quote.
        s = i + 1
        j = s
        while (j <= n) {
          c = substr(buf, j, 1)
          if (c == "\\") { j += 2; continue }
          if (c == "\"") break
          j++
        }
        i = j + 1

        # A string is a key only when a colon follows it.
        k = i
        while (k <= n && index(" \t\n\r", substr(buf, k, 1)) > 0) k++
        if (substr(buf, k, 1) != ":") continue
        i = k + 1
        if (depth != 1 || stack[1] != "{" || substr(buf, s, j - s) != key) continue

        while (i <= n && index(" \t\n\r", substr(buf, i, 1)) > 0) i++
        if (substr(buf, i, 1) != "\"") continue
        s = i + 1
        j = s
        while (j <= n) {
          c = substr(buf, j, 1)
          if (c == "\\") { j += 2; continue }
          if (c == "\"") break
          j++
        }
        print substr(buf, s, j - s)
        exit
      }
    }'
}

tt_clean() { # text
  printf '%s' "$1" | tr '\t\n\r' '   ' | cut -c1-200
}

# Counts whitespace-separated words in a JSON string token without ever writing
# the token to disk. JSON-escaped newlines and tabs are separators too.
tt_word_count() { # JSON string contents, still escaped
  printf '%s' "$1" | awk '
    { text = text (NR > 1 ? " " : "") $0 }
    END {
      gsub(/\\[nrt]/, " ", text)
      gsub(/^[[:space:]]+/, "", text)
      gsub(/[[:space:]]+$/, "", text)
      if (text == "") print 0
      else print split(text, word, /[[:space:]]+/)
    }'
}

tt_positive_number() { # value
  awk -v value="$1" 'BEGIN {
    if (value ~ /^[0-9]+([.][0-9]+)?$/ && value + 0 > 0) exit 0
    exit 1
  }'
}

# Zero is a meaningful setting for the knobs that can be switched off, so those
# validate against this instead.
tt_nonnegative_number() { # value
  awk -v value="$1" 'BEGIN {
    if (value ~ /^[0-9]+([.][0-9]+)?$/) exit 0
    exit 1
  }'
}

# The environment outranks the config file, which is why each caller passes the
# marker captured before defaults were applied: an unset variable must still
# yield to the file. A value the validator rejects is a typo, and a typo must
# not quietly redefine what a report counts.
tt_number_setting() { # name set-marker current default validator
  value=$3
  if [ -z "$2" ]; then
    configured=$(tt_config "$1") || configured=''
    [ -z "${configured:-}" ] || value=$configured
  fi
  "$5" "$value" || value=$4
  printf '%s\n' "$value"
}

tt_reading_wpm() {
  tt_number_setting TT_READING_WPM "$TT_READING_WPM_SET" \
    "$TT_READING_WPM" 120 tt_nonnegative_number
}

tt_max_reading_time() {
  tt_number_setting TT_MAX_READING_TIME "$TT_MAX_READING_TIME_SET" \
    "$TT_MAX_READING_TIME" 600 tt_positive_number
}

tt_max_active_gap() {
  tt_number_setting TT_MAX_ACTIVE_GAP "$TT_MAX_ACTIVE_GAP_SET" \
    "$TT_MAX_ACTIVE_GAP" 3600 tt_nonnegative_number
}

# Config file, then environment, then default -- the same order tt_idle_gap's
# inline callers already use, since these two knobs feed the Python reporter
# rather than a value captured at process start with an environment-set marker.
tt_presence_gap() {
  value=$(tt_config TT_PRESENCE_GAP) || value=''
  [ -n "${value:-}" ] || value=${TT_PRESENCE_GAP:-3600}
  tt_positive_number "$value" || value=3600
  printf '%s' "$value"
}

tt_checkin_window() {
  value=$(tt_config TT_CHECKIN_WINDOW) || value=''
  [ -n "${value:-}" ] || value=${TT_CHECKIN_WINDOW:-1200}
  tt_positive_number "$value" || value=1200
  printf '%s' "$value"
}

# Accepts 90m, 1.5h, 2h30m, or a bare number read as minutes.
tt_seconds() { # duration
  printf '%s' "$1" | awk '
    {
      s = tolower($0)
      if (s ~ /^[0-9]+(\.[0-9]+)?$/) { printf "%d\n", s * 60; exit 0 }
      total = 0; matched = 0
      while (match(s, /^[0-9]+(\.[0-9]+)?[hm]/)) {
        piece = substr(s, 1, RLENGTH)
        unit  = substr(piece, RLENGTH, 1)
        value = substr(piece, 1, RLENGTH - 1) + 0
        total += (unit == "h") ? value * 3600 : value * 60
        s = substr(s, RLENGTH + 1)
        matched = 1
      }
      if (matched && s == "") { printf "%d\n", total; exit 0 }
      exit 1
    }'
}

cmd_add() {
  [ $# -ge 2 ] || tt_die "usage: tt add PROJECT DURATION [NOTE] [--at 'YYYY-MM-DD HH:MM']"
  proj=$1; dur=$2; shift 2
  note='-'; at=''
  while [ $# -gt 0 ]; do
    case "$1" in
      --at) [ $# -ge 2 ] || tt_die "--at needs a 'YYYY-MM-DD HH:MM' argument"; at=$2; shift 2 ;;
      *)    note=$1; shift ;;
    esac
  done

  # An unparseable duration leaves awk silent, whatever it exits with.
  secs=$(tt_seconds "$dur")
  case "$secs" in
    ''|*[!0-9]*) tt_die "cannot parse duration: $dur" ;;
  esac

  if [ -n "$at" ]; then start=$(tt_epoch "$at") || exit 1; end=$((start + secs))
  else end=$(tt_now); start=$((end - secs))
  fi

  mkdir -p "$TT_HOME" || tt_die "cannot create $TT_HOME"
  row=$(printf '%s\tspan\t%s\t%s\t%s\t-\tmanual\t%s\t.\t-\t%s' \
    "$(tt_iso "$start")" "$start" "$end" "$(tt_machine)" \
    "$(tt_clean "$proj")" "$(tt_clean "$note")")
  tt_append_row "$row" "$start" || tt_die "cannot write $(tt_log_file)"
  printf '%s\n' "$row"
}

# A fingerprint identifies a repeated prompt without storing what it said.
# cksum is in POSIX and present on both target platforms; the value only has
# to be stable within one machine's log.
tt_fingerprint() { # string
  printf '%s' "$1" | cksum | awk '{ printf "%08x\n", $1 }'
}

tt_solo_commands() {
  value=$(tt_config TT_SOLO_COMMANDS) || value=''
  [ -n "${value:-}" ] || value=${TT_SOLO_COMMANDS:-goal,loop,schedule}
  printf '%s' "$value"
}

tt_trigger_file() { # session
  printf '%s/trigger/%s' "$TT_HOME" "$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_')"
}

# Prints CLASS<tab>FINGERPRINT for a submitted prompt.
#
# A /loop or /schedule wake-up resubmits the exact prompt that started the
# run, so its first word still names a trigger command. The recorded
# fingerprint is therefore checked first: only a prompt that is not already
# the session's known trigger can newly classify as trigger, so a replay
# lands on the fingerprint match (machine) instead of re-triggering.
tt_classify_prompt() { # prompt session
  prompt=$1; sid=$2
  if [ -z "$prompt" ]; then printf -- '-\t-\n'; return 0; fi
  fp=$(tt_fingerprint "$prompt")
  known=$(cat "$(tt_trigger_file "$sid")" 2>/dev/null) || known=''
  if [ -n "$known" ] && [ "$known" = "$fp" ]; then
    printf 'machine\t%s\n' "$fp"
    return 0
  fi
  # The command word, without its leading slash or any plugin: prefix.
  word=$(printf '%s' "$prompt" | awk '{ print $1 }' | sed 's|^/||; s|^[^:]*:||')
  if printf '%s' "$(tt_solo_commands)" | tr ',' '\n' | grep -qx -- "$word"; then
    mkdir -p "$TT_HOME/trigger" 2>/dev/null || :
    printf '%s\n' "$fp" > "$(tt_trigger_file "$sid")" 2>/dev/null || :
    printf 'trigger\t%s\n' "$fp"
    return 0
  fi
  printf 'human\t%s\n' "$fp"
}

cmd_hook() {
  input=$(cat 2>/dev/null) || input=''

  cwd=$(tt_json_str cwd "$input")
  [ -n "$cwd" ] || cwd=$PWD
  sid=$(tt_json_str session_id "$input")
  [ -n "$sid" ] || sid='-'
  evt=$(tt_json_str hook_event_name "$input")
  [ -n "$evt" ] || evt='-'
  # Codex calls the turn identifier turn_id and Claude Code calls it prompt_id.
  # Both name a single user turn, so either fills the same column.
  turn=$(tt_json_str turn_id "$input")
  [ -n "$turn" ] || turn=$(tt_json_str prompt_id "$input")
  [ -n "$turn" ] || turn='-'
  tool=$(tt_json_str tool_use_id "$input")
  [ -n "$tool" ] || tool='-'
  agent=$(tt_json_str agent_id "$input")
  [ -n "$agent" ] || agent='-'
  agent_type=$(tt_json_str agent_type "$input")
  [ -n "$agent_type" ] || agent_type='-'
  session_source=$(tt_json_str source "$input")
  [ -n "$session_source" ] || session_source='-'
  words='-'
  if [ "$evt" = Stop ]; then
    message=$(tt_json_str last_assistant_message "$input")
    [ -z "$message" ] || words=$(tt_word_count "$message")
  fi
  tool_name=$(tt_json_str tool_name "$input")
  [ -n "$tool_name" ] || tool_name='-'
  user_prompt=$(tt_json_str user_prompt "$input")
  [ -n "$user_prompt" ] || user_prompt=$(tt_json_str prompt "$input")
  prompt_class='-'; prompt_fp='-'
  if [ "$evt" = UserPromptSubmit ]; then
    classified=$(tt_classify_prompt "$user_prompt" "$sid")
    prompt_class=$(printf '%s' "$classified" | cut -f1)
    prompt_fp=$(printf '%s' "$classified" | cut -f2)
  fi
  [ "$evt" != SessionEnd ] || rm -f "$(tt_trigger_file "$sid")" 2>/dev/null || :

  # Codex sets CLAUDE_PLUGIN_ROOT and CLAUDE_PLUGIN_DATA next to its own
  # PLUGIN_ROOT and PLUGIN_DATA, so a hook it runs answers to both names.
  # Only Codex sets the unprefixed pair, so that is read first. CODEX_HOME is
  # not consulted: a user may export it from a login shell, and a hook inherits
  # the login environment, which would attribute every Claude beat as Codex.
  if [ -n "${PLUGIN_ROOT:-}" ]; then harness=codex
  elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] || [ -n "${CLAUDECODE:-}" ]; then harness=claude
  else harness='-'
  fi

  now=$(tt_now)
  attrib=$(tt_attribute "$cwd")
  proj=$(printf '%s' "$attrib" | cut -f1)
  sub=$(printf '%s' "$attrib" | cut -f2)
  mode=$(tt_mode "$cwd" "$sid")

  row=$(printf '%s\tbeat\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' \
    "$(tt_iso "$now")" "$now" "$now" "$(tt_machine)" "$harness" "$mode" \
    "$(tt_clean "$proj")" "$(tt_clean "$sub")" "$(tt_clean "$sid")" "$(tt_clean "$evt")" \
    "$(tt_clean "$turn")" "$(tt_clean "$tool")" "$(tt_clean "$agent")" \
    "$(tt_clean "$agent_type")" "$words" "$(tt_clean "$session_source")" \
    "$(tt_clean "$tool_name")" "$prompt_class" "$prompt_fp")
  tt_append_row "$row" "$now" >/dev/null 2>&1 || :

  # A replayed /loop or /schedule wake-up sets solo automatically; a genuine
  # human prompt does not, and neither does a replay already covered by an
  # earlier trigger (classified machine, not trigger again). Both the durable
  # row and the capture-time cache are updated, so the transition is visible
  # in a report immediately and to this session's very next beat.
  if [ "$prompt_class" = trigger ]; then
    tt_cache_mode solo "$cwd" "$sid" >/dev/null 2>&1 || :
    tt_write_mode_row solo "$cwd" "$sid" "$now" auto >/dev/null 2>&1 || :
  fi
  return 0
}

# The first instant of a local day. Nothing here parses a midnight, because a
# spring-forward landing on 00:00 deletes it -- Santiago, Havana and Tehran all
# do this, and the date has no local 00:00 to parse. Subtracting the wall-clock
# time of day instead lands within one DST shift of the true start (exactly on
# it when the day holds no transition), and the day boundary is walked to from
# there. The walk terminates: the estimate is never later than the given epoch,
# so it sits on the wanted day or on an earlier one.
tt_midnight() { # epoch -> epoch of that local day's first instant
  day=$(tt_fmt "$1" '%Y-%m-%d') || exit 1
  hms=$(tt_fmt "$1" '%H %M %S') || exit 1
  set -- "$1" $hms
  # %H, %M and %S are zero-padded, and POSIX arithmetic reads a leading zero
  # as octal, so 08 and 09 would be errors. Strip it.
  e=$(( $1 - ${2#0} * 3600 - ${3#0} * 60 - ${4#0} ))
  while [ "$(tt_fmt "$e" '%Y-%m-%d')" != "$day" ]; do e=$((e + 900)); done
  while [ "$(tt_fmt "$((e - 900))" '%Y-%m-%d')" = "$day" ]; do e=$((e - 900)); done
  printf '%s\n' "$e"
}

tt_day_start() { # YYYY-MM-DD -> first real instant of that local day
  noon=$(tt_epoch "$1 12:00") || return 1
  tt_midnight "$noon"
}

tt_next_midnight() { # local-day start -> next local-day start
  # Thirty-six elapsed hours from a day boundary always lands inside the next
  # civil day across ordinary 23-, 24- and 25-hour DST days.
  tt_midnight "$(( $1 + 129600 ))"
}

# Yields the bare epoch of each local midnight in the window -- what
# ttreport's repeatable --boundary option wants, for both reporting and
# compaction.
tt_day_boundary_epochs() { # since upto
  cursor=$(tt_midnight "$1") || return 1
  while [ "$cursor" -lt "$2" ]; do
    printf '%s\n' "$cursor"
    next=$(tt_next_midnight "$cursor") || return 1
    [ "$next" -gt "$cursor" ] || return 1
    cursor=$next
  done
}

# Prefixing with the input sequence gives equal-second events a stable ordering
# after sort. This is shared by reporting, compaction, and carry-state creation.
tt_sort_events() {
  tab=$(printf '\t')
  awk -F '\t' '{ printf "%d\t%s\n", NR, $0 }' \
    | sort -t "$tab" -k 4,4n -k 1,1n \
    | cut -f 2-
}

# The compactor cannot rely on a pipeline status: POSIX sh reports only the
# final command, so a failed sort could otherwise look successful and replace
# the log with incomplete output. Stage and check each step separately.
tt_sort_file() { # input output
  sort_input=$1
  sort_output=$2
  sort_numbered="$sort_output.numbered"
  sort_ordered="$sort_output.ordered"
  sort_tab=$(printf '\t')
  if ! awk -F '\t' '{ printf "%d\t%s\n", NR, $0 }' "$sort_input" > "$sort_numbered"; then
    rm -f "$sort_numbered" "$sort_ordered" "$sort_output"
    return 1
  fi
  if ! sort -t "$sort_tab" -k 4,4n -k 1,1n "$sort_numbered" > "$sort_ordered"; then
    rm -f "$sort_numbered" "$sort_ordered" "$sort_output"
    return 1
  fi
  if ! cut -f 2- "$sort_ordered" > "$sort_output"; then
    rm -f "$sort_numbered" "$sort_ordered" "$sort_output"
    return 1
  fi
  rm -f "$sort_numbered" "$sort_ordered"
  return 0
}

tt_compact_marker() { # compact-file
  [ -f "$1" ] || return 0
  awk -F '\t' 'NR == 1 { if ($2 == "compact") print $3; exit }' "$1"
}

tt_validate_rows() { # file role
  valid_file=$1
  valid_role=$2
  [ -f "$valid_file" ] || return 0
  awk -F '\t' -v role="$valid_role" '
    function uint(value) { return value ~ /^[0-9]+$/ }
    function tracked_mode(value) {
      return value == "paired" || value == "solo" || value == "manual"
    }
    function tracked_category(value) {
      return value == "paired" || value == "checkin" || value == "manual" ||
             value == "agent" || value == "tool"
    }
    function valid_compact() {
      return NF >= 11 && uint($3) && uint($4) && $3 == $4
    }
    # A total row is either the retired 12-field layout -- mode in column 7,
    # seconds in column 11 -- or the current 20-field layout -- category in
    # column 7, seconds in column 16. Both can coexist in the same file: the
    # 87 rows a real log already holds are never rewritten.
    function valid_total_old() {
      return NF == 12 && uint($3) && uint($4) && $4 > $3 &&
             tracked_mode($7) && $8 != "" && $9 != "" &&
             uint($11) && uint($12)
    }
    function valid_total_new() {
      return NF == 20 && uint($3) && uint($4) && $4 > $3 &&
             tracked_category($7) && $8 != "" && $9 != "" && uint($16)
    }
    function valid_total() {
      return valid_total_old() || valid_total_new()
    }
    function valid_beat() {
      return NF >= 11 && uint($3) && uint($4) && $4 >= $3 &&
             ($7 == "paired" || $7 == "solo") && $8 != "" && $9 != ""
    }
    function valid_span() {
      return NF >= 11 && uint($3) && uint($4) && $4 >= $3 &&
             $7 == "manual" && $8 != "" && $9 != ""
    }
    function valid_mode_event() {
      return NF >= 11 && uint($3) && uint($4) && $3 == $4 &&
             ($7 == "paired" || $7 == "solo") &&
             $8 != "" && $9 != "" && $10 != ""
    }
    function tracked_state_event(value) {
      return value == "heartbeat" || value == "turn" || value == "tool"
    }
    # Same split as total: the retired reading-estimate model at its own,
    # narrower width, or the current 20-field layout -- a carried
    # heartbeat, turn or tool bracket, dated at its own instant ($3 == $4)
    # with the cutoff that carried it in column 16.
    function valid_state_old() {
      return NF >= 18 && NF != 20 && uint($3) && uint($4) && $4 >= $3 &&
             ($7 == "paired" || $7 == "solo") && $8 != "" && $9 != ""
    }
    function valid_state_new() {
      return NF == 20 && uint($3) && uint($4) && $3 == $4 &&
             tracked_state_event($11) && $8 != "" && $9 != "" && uint($16)
    }
    function valid_state() {
      return valid_state_old() || valid_state_new()
    }
    function valid_state_child() {
      return NF >= 12 && uint($3) && uint($4) && $4 >= $3 &&
             ($7 == "paired" || $7 == "solo") && $8 != "" && $9 != ""
    }
    function valid_detail() {
      return ($2 == "beat" && valid_beat()) ||
             ($2 == "span" && valid_span()) ||
             ($2 == "mode" && valid_mode_event()) ||
             ($2 == "state" && valid_state()) ||
             (($2 == "state-tool" || $2 == "state-agent") && valid_state_child())
    }
    $0 == "" { next }
    role == "compact-source" {
      if (($2 == "compact" && valid_compact()) ||
          ($2 == "total" && valid_total()) || valid_detail()) next
      bad = 1; next
    }
    role == "current-source" {
      if (valid_detail()) next
      bad = 1; next
    }
    role == "compact-output" {
      if ($2 == "total" && valid_total()) next
      bad = 1; next
    }
    role == "state-output" {
      if (($2 == "state" && valid_state()) ||
          (($2 == "state-tool" || $2 == "state-agent") && valid_state_child())) next
      bad = 1; next
    }
    { bad = 1 }
    END { exit bad ? 1 : 0 }
  ' "$valid_file"
}

tt_storage_valid() {
  tt_validate_rows "$(tt_compact_file)" compact-source &&
    tt_validate_rows "$(tt_current_file)" current-source
}

tt_compact_has_detail() { # compact-file
  [ -f "$1" ] || return 1
  awk -F '\t' '
    $2 == "beat" || $2 == "span" || $2 == "mode" || $2 == "state" ||
    $2 == "state-tool" || $2 == "state-agent" { found = 1; exit }
    END { exit found ? 0 : 1 }
  ' "$1"
}

tt_compact_cleanup() {
  rm -f "$compact_detail" "$compact_keep" "$compact_combined" \
    "$compact_sorted" "$compact_history" "$compact_new" "$current_new"
}

# The caller holds the per-machine event lock. Reconstruct all detail before
# cutoff into daily totals through the Python reconstruction, and carry
# forward only what has not yet closed: today's beats and mode transitions,
# and the still-open tail of a manual span that straddles the boundary
# (ttreport.compact splits that tail out itself). A legacy or interrupted
# deployment can leave raw detail sitting inside the compact file itself, so
# that file's own beat/span/mode/state rows are swept in alongside
# current-<machine>.tsv; only its total rows -- in either column layout --
# pass through untouched, so years of history are never reprocessed just to
# compact today. A stale compact marker is dropped rather than kept, since
# the fresh marker below always replaces it.
tt_compact_locked() { # cutoff-epoch
  compact_cutoff=$1
  tt_ensure_gitignore || return 1
  compact_file=$(tt_compact_file)
  current_file=$(tt_current_file)
  compact_machine=$(tt_machine)
  compact_detail="$TT_HOME/.tt-detail-$compact_machine.$$"
  compact_keep="$TT_HOME/.tt-keep-$compact_machine.$$"
  compact_combined="$TT_HOME/.tt-combined-$compact_machine.$$"
  compact_sorted="$TT_HOME/.tt-sorted-$compact_machine.$$"
  compact_history="$TT_HOME/.tt-history-$compact_machine.$$"
  compact_new="$TT_HOME/.tt-compact-$compact_machine.$$"
  current_new="$TT_HOME/.tt-current-$compact_machine.$$"
  compact_day=$(tt_fmt "$compact_cutoff" '%Y-%m-%d') || return 1
  compact_lib=${TT_LIB:-$(tt_self)/../lib}

  [ -f "$compact_file" ] || : > "$compact_file"
  [ -f "$current_file" ] || : > "$current_file"
  if ! tt_storage_valid; then
    tt_compact_cleanup
    return 1
  fi
  if ! awk -F '\t' -v detail="$compact_detail" -v keep="$compact_keep" '
      $2 == "beat" || $2 == "span" || $2 == "mode" ||
      $2 == "state" || $2 == "state-tool" || $2 == "state-agent" {
        print > detail; next
      }
      $2 == "compact" { next }
      { print > keep }
    ' "$compact_file"; then
    tt_compact_cleanup
    return 1
  fi
  [ -f "$compact_detail" ] || : > "$compact_detail"
  [ -f "$compact_keep" ] || : > "$compact_keep"
  if ! cat "$compact_detail" "$current_file" > "$compact_combined"; then
    tt_compact_cleanup
    return 1
  fi
  if ! tt_sort_file "$compact_combined" "$compact_sorted"; then
    tt_compact_cleanup
    return 1
  fi

  if ! compact_first=$(awk -F '\t' -v cutoff="$compact_cutoff" '
      $0 != "" && ($3 + 0) < cutoff {
        at = $3 + 0
        if (!seen || at < first) { first = at; seen = 1 }
      }
      END { if (seen) print first }
    ' "$compact_sorted"); then
    tt_compact_cleanup
    return 1
  fi

  if [ -n "$compact_first" ]; then
    compact_since=$(tt_midnight "$compact_first") || {
      tt_compact_cleanup; return 1;
    }
    compact_presence=$(tt_presence_gap)
    compact_checkin=$(tt_checkin_window)
    compact_active=$(tt_max_active_gap)
    set -- --cutoff "$compact_cutoff" --carry "$current_new" \
           --presence-gap "$compact_presence" \
           --checkin-window "$compact_checkin" \
           --max-active "$compact_active"
    for boundary in $(tt_day_boundary_epochs "$compact_since" "$((compact_cutoff + 1))"); do
      set -- "$@" --boundary "$boundary"
    done
    if ! PYTHONPATH="$compact_lib" python3 -m ttreport.compact "$@" \
        < "$compact_sorted" > "$compact_history"; then
      tt_compact_cleanup
      return 1
    fi
  else
    # Nothing precedes the cutoff: carry today's rows through untouched
    # rather than round-tripping them through the reconstruction.
    if ! cp "$compact_sorted" "$current_new"; then
      tt_compact_cleanup
      return 1
    fi
    : > "$compact_history" || { tt_compact_cleanup; return 1; }
  fi
  if ! tt_validate_rows "$compact_history" compact-output; then
    tt_compact_cleanup
    return 1
  fi
  if ! tt_validate_rows "$current_new" current-source; then
    tt_compact_cleanup
    return 1
  fi

  if ! printf '%s\tcompact\t%s\t%s\t%s\t-\t-\t-\t-\t-\t-\n' \
      "$compact_day" "$compact_cutoff" "$compact_cutoff" "$compact_machine" \
      > "$compact_new"; then
    tt_compact_cleanup
    return 1
  fi
  if ! cat "$compact_history" >> "$compact_new"; then
    tt_compact_cleanup
    return 1
  fi
  if ! cat "$compact_keep" >> "$compact_new"; then
    tt_compact_cleanup
    return 1
  fi
  if ! tt_validate_rows "$compact_new" compact-source; then
    tt_compact_cleanup
    return 1
  fi

  # Moving current first keeps all raw source available in the old compact file
  # if the second move fails during a legacy migration.
  if ! mv "$current_new" "$current_file"; then
    tt_compact_cleanup
    return 1
  fi
  if ! mv "$compact_new" "$compact_file"; then
    tt_compact_cleanup
    return 1
  fi
  tt_compact_cleanup
  return 0
}

tt_compact() { # [force]
  mkdir -p "$TT_HOME" || return 1
  tt_event_lock || return 1
  trap 'tt_event_unlock' EXIT HUP INT TERM
  compact_today=$(tt_midnight "$(tt_now)") || {
    tt_event_unlock; trap - EXIT HUP INT TERM; return 1;
  }
  if ! tt_gitignore_ready && ! tt_ensure_gitignore; then
    tt_event_unlock; trap - EXIT HUP INT TERM; return 1
  fi
  if ! tt_storage_valid; then
    tt_event_unlock; trap - EXIT HUP INT TERM; return 1
  fi
  compact_marker=$(tt_compact_marker "$(tt_compact_file)")
  if [ "${1:-}" = force ] || [ "$compact_marker" != "$compact_today" ] ||
      tt_compact_has_detail "$(tt_compact_file)"; then
    tt_compact_locked "$compact_today" || {
      tt_event_unlock; trap - EXIT HUP INT TERM; return 1;
    }
  fi
  tt_event_unlock
  trap - EXIT HUP INT TERM
  return 0
}

tt_append_row() { # row start-epoch
  append_text=$1
  append_at=$2
  mkdir -p "$TT_HOME" || return 1
  tt_event_lock || return 1
  trap 'tt_event_unlock' EXIT HUP INT TERM
  if ! tt_gitignore_ready && ! tt_ensure_gitignore; then
    tt_event_unlock; trap - EXIT HUP INT TERM; return 1
  fi
  if ! printf '%s\n' "$append_text" >> "$(tt_current_file)"; then
    tt_event_unlock; trap - EXIT HUP INT TERM; return 1
  fi
  append_today=$(tt_midnight "$(tt_now)") || {
    tt_event_unlock; trap - EXIT HUP INT TERM; return 1;
  }
  append_marker=$(tt_compact_marker "$(tt_compact_file)")
  if [ "$append_marker" != "$append_today" ] || [ "$append_at" -lt "$append_today" ]; then
    tt_compact_locked "$append_today" || {
      tt_event_unlock; trap - EXIT HUP INT TERM; return 1;
    }
  fi
  tt_event_unlock
  trap - EXIT HUP INT TERM
  return 0
}

tt_ensure_gitignore() {
  ignore_file="$TT_HOME/.gitignore"
  ignore_new="$TT_HOME/.tt-ignore.$$"
  if [ -f "$ignore_file" ]; then ignore_source=$ignore_file
  else ignore_source=/dev/null
  fi
  if ! awk '
    { print; seen[$0] = 1 }
    END {
      if (!seen["modes"]) print "modes"
      if (!seen["modes.lock/"]) print "modes.lock/"
      if (!seen["events-*.lock/"]) print "events-*.lock/"
      if (!seen["current-*.tsv"]) print "current-*.tsv"
      if (!seen[".tt-*"]) print ".tt-*"
    }
  ' "$ignore_source" > "$ignore_new"; then
    rm -f "$ignore_new"
    return 1
  fi
  mv "$ignore_new" "$ignore_file" || { rm -f "$ignore_new"; return 1; }
}

tt_gitignore_ready() {
  ignore_file="$TT_HOME/.gitignore"
  [ -f "$ignore_file" ] || return 1
  awk '
    $0 == "modes" { modes = 1 }
    $0 == "modes.lock/" { modes_lock = 1 }
    $0 == "events-*.lock/" { events_lock = 1 }
    $0 == "current-*.tsv" { current = 1 }
    $0 == ".tt-*" { temporary = 1 }
    END { exit modes && modes_lock && events_lock && current && temporary ? 0 : 1 }
  ' "$ignore_file"
}

cmd_report_help() {
  cat <<'USAGE'
Usage: tt report [PERIOD] [OPTIONS]

PERIOD
  today       today from its first local instant (default)
  yesterday   the complete previous local day
  week        this week from Monday through now
  month       this month from its first local day through now

OPTIONS
  --since YYYY-MM-DD   start at the first local instant of this date
  --until YYYY-MM-DD   include this complete local date
  --by project|day     group by project (default) or local day
  --detail             break projects out by session sub-directory
  -h, --help           show this help

EFFORT is the sum of PAIRED, CHECKIN and MANUAL. AGENT and TOOL are machine
time and are never part of that sum.
USAGE
}

cmd_report() {
  now=$(tt_now)
  since=''; upto=$now; byday=0; detail=0
  while [ $# -gt 0 ]; do
    case "$1" in
      today)    since=$(tt_midnight "$now") || exit 1; shift ;;
      yesterday) upto=$(tt_midnight "$now") || exit 1
                since=$(tt_midnight "$((upto - 1))") || exit 1; shift ;;
      # Subtracting whole days can land on 23:00 or 01:00 across a DST change,
      # so the result is put back through tt_midnight to reach that day's 00:00.
      week)     mid=$(tt_midnight "$now") || exit 1
                u=$(tt_fmt "$now" '%u') || exit 1
                since=$(tt_midnight "$((mid - (u - 1) * 86400))") || exit 1
                shift ;;
      month)    ym=$(tt_fmt "$now" '%Y-%m') || exit 1
                since=$(tt_day_start "$ym-01") || exit 1; shift ;;
      --since)  [ $# -ge 2 ] || tt_die "--since needs a YYYY-MM-DD argument"
                since=$(tt_day_start "$2") || exit 1; shift 2 ;;
      --until)  [ $# -ge 2 ] || tt_die "--until needs a YYYY-MM-DD argument"
                day_start=$(tt_day_start "$2") || exit 1
                upto=$(tt_next_midnight "$day_start") || exit 1; shift 2 ;;
      --by)     [ $# -ge 2 ] || tt_die "--by needs project or day"
                case "$2" in
                  project) byday=0 ;;
                  day)     byday=1 ;;
                  *)       tt_die "--by needs project or day" ;;
                esac
                shift 2 ;;
      --detail) detail=1; shift ;;
      -h|--help|help) cmd_report_help; return 0 ;;
      *)        tt_die "unknown report option: $1 (run 'tt report --help')" ;;
    esac
  done
  [ -n "$since" ] || since=$(tt_midnight "$now") || exit 1

  presence_gap=$(tt_presence_gap)
  checkin_window=$(tt_checkin_window)
  max_active=$(tt_max_active_gap)
  lib=${TT_LIB:-$(tt_self)/../lib}

  # A report is also a convenient first action after midnight or after an
  # upgrade from the single-file format.
  tt_compact || tt_die "cannot compact $(tt_compact_file)"

  set -- --since "$since" --upto "$upto" \
         --presence-gap "$presence_gap" \
         --checkin-window "$checkin_window" \
         --max-active "$max_active"
  [ "$detail" -eq 0 ] || set -- "$@" --detail
  if [ "$byday" -eq 1 ]; then
    set -- "$@" --byday
    for boundary in $(tt_day_boundary_epochs "$since" "$upto"); do
      set -- "$@" --boundary "$boundary"
    done
  fi

  # Prefix each row with its input sequence before sorting. The sequence is the
  # numeric tie-breaker for equal-second events, preserving append order without
  # relying on sort's implementation-specific final lexical comparison.
  {
    cat "$TT_HOME"/events-*.tsv 2>/dev/null
    cat "$TT_HOME"/current-*.tsv 2>/dev/null
  } | tt_sort_events | PYTHONPATH="$lib" python3 -m ttreport "$@"
}

cmd_init() {
  mkdir -p "$TT_HOME" || tt_die "cannot create $TT_HOME"
  [ -f "$TT_HOME/config" ] || printf '# machine=\n# TT_ROOT=\n# TT_IDLE_GAP=1800\n# TT_MAX_ACTIVE_GAP=3600\n# TT_READING_WPM=120 (0 disables the reading estimate)\n# TT_MAX_READING_TIME=600\n# TT_SOLO_COMMANDS=goal,loop,schedule\n' > "$TT_HOME/config"
  f=$(tt_compact_file); [ -f "$f" ] || : > "$f"
  f=$(tt_current_file); [ -f "$f" ] || : > "$f"
  f=$(tt_modes_file); [ -f "$f" ] || : > "$f"
  tt_ensure_gitignore || tt_die "cannot update $TT_HOME/.gitignore"
  tt_compact || tt_die "cannot initialise compact log"
  printf 'initialised %s (machine: %s)\n' "$TT_HOME" "$(tt_machine)"
}

cmd_sessions() {
  f=$(tt_modes_file)
  [ -f "$f" ] || return 0
  awk -F '\t' 'NF >= 2 {
    session = (NF >= 3 && $3 != "" ? $3 : "-")
    printf "%-7s %-12s %s\n", $1, (session == "-" ? "all" : session), $2
  }' "$f"
}

# Both remote commands hand this string to a shell running on the far side --
# rsync expands a remote path there, and install-remote runs a script there --
# so a host name is held to what a host name is made of. Refusing an odd one is
# shorter than quoting it correctly through two shells, and a leading hyphen
# would otherwise be read by ssh as an option rather than a destination.
tt_host_ok() { # [user@]host
  case "$1" in
    ''|-*|@*|*@|*@*@*)  return 1 ;;
    *[!A-Za-z0-9._@-]*) return 1 ;;
  esac
  return 0
}

tt_bad_host() { # host
  tt_die "not a usable host name: $1 (expected [user@]host of letters, digits, dots, hyphens and underscores)"
}

cmd_sync() {
  [ "${1:-}" = pull ] || tt_die "usage: tt sync pull HOST"
  shift
  host=${1:-}
  [ -n "$host" ] || tt_die "usage: tt sync pull HOST"
  tt_host_ok "$host" || tt_bad_host "$host"
  mkdir -p "$TT_HOME" || tt_die "cannot create $TT_HOME"
  tt_ensure_gitignore || tt_die "cannot update $TT_HOME/.gitignore"
  # Both whole files are replaced, so repeating a pull changes nothing. The
  # high-volume current file stays outside Git but is still useful in a report
  # run on the trusted machine before the remote host reaches midnight.
  for sync_kind in events current; do
    ${TT_RSYNC:-rsync} -a \
      "$host:.timetrack/$sync_kind-$host.tsv" \
      "$TT_HOME/$sync_kind-$host.tsv"
    st=$?
    # ssh reports its own failures as 255 and rsync passes that through, so a
    # connection problem and a problem at the other end are distinguished.
    case $st in
      0)   ;;
      255) tt_die "could not reach $host" ;;
      *)   tt_die "reached $host, but $sync_kind-$host.tsv did not copy (rsync exit $st); update timetrack on the host and check that ~/.timetrack/config says machine=$host" ;;
    esac
  done
  printf 'pulled events-%s.tsv and current-%s.tsv\n' "$host" "$host"
}

cmd_install_remote() {
  host=${1:-}
  [ -n "$host" ] || tt_die "usage: tt install-remote HOST"
  tt_host_ok "$host" || tt_bad_host "$host"
  # The remote fetches the tool itself: the repository is public, so its clone is
  # anonymous and touches no account, and the only fact that travels from here
  # is the name this machine is logged under. The same command provisions a new
  # host and updates one already installed.
  #
  # The config is rewritten whole by awk rather than patched by sed, so a file
  # whose last line was hand-edited without a trailing newline gains one instead
  # of having the next key run onto the end of it. The rewrite is tested
  # explicitly rather than joined to the mv with &&: set -e exempts a command
  # that precedes &&, so a failed rewrite would fall through to tt init and the
  # whole install would exit 0 without ever naming the machine.
  remote=$(cat <<EOF
set -e
d=\$HOME/timetrack-plugin
if [ -d "\$d/.git" ]; then git -C "\$d" pull --ff-only
else git clone https://github.com/Langerrr/timetrack.git "\$d"
fi
mkdir -p "\$HOME/.timetrack"
c=\$HOME/.timetrack/config
[ -f "\$c" ] || : > "\$c"
if ! awk -v m='machine=$host' '
  /^machine=/ { print m; seen = 1; next }
  { print }
  END { if (!seen) print m }
' "\$c" > "\$c.new"; then
  rm -f "\$c.new"
  echo "tt: could not write machine=$host into \$c" >&2
  exit 1
fi
mv "\$c.new" "\$c"
sh "\$d/bin/tt" init
EOF
)
  ${TT_SSH:-ssh} "$host" "$remote"
  st=$?
  case $st in
    0)   ;;
    255) tt_die "could not reach $host" ;;
    *)   tt_die "reached $host, but the setup did not finish (exit $st); check that git on $host can clone from github.com" ;;
  esac
  cat <<EOF

$host now has ~/timetrack-plugin and machine=$host in ~/.timetrack/config, so
its compact and current files use the suffix $host and 'tt sync pull $host'
finds both.

The clone carries its own marketplace manifest, so it registers as the
marketplace 'timetrack' holding the plugin 'timetrack'. Both harnesses want the
plugin named with its marketplace; a bare name is refused.

Register it on $host, in each harness you use there:
  claude: /plugin marketplace add ~/timetrack-plugin
          /plugin install timetrack@timetrack
  codex:  codex plugin marketplace add ~/timetrack-plugin
          codex plugin add timetrack@timetrack

Codex skips a plugin's hooks until they are trusted, and says nothing when it
does, so start one interactive session on $host and accept the hook prompt.

$host clones the published repository, so push anything you want it to have
before running this. Running it again pulls in place.

$host keeps no credentials: the clone is anonymous and nothing is pushed from
it. Pull its log from a trusted machine with:
  tt sync pull $host
EOF
}

cmd_hooks_snippet() {
  case "${1:-claude}" in
    claude) events='SessionStart UserPromptSubmit PreToolUse PostToolUse
                    PostToolUseFailure PermissionDenied SubagentStart
                    SubagentStop Stop StopFailure SessionEnd'
            cmd='sh -c '"'"'exec "${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/bin/tt" hook'"'"''
            printf 'Add to ~/.claude/settings.json under "hooks":\n\n' ;;
    codex)  events='SessionStart UserPromptSubmit PreToolUse PostToolUse Stop Interrupt SessionEnd SubagentStart SubagentStop'
            cmd='sh -c '"'"'exec "$PLUGIN_ROOT/bin/tt" hook'"'"''
            printf 'Add to ~/.codex/config.toml under [hooks], or ship hooks/codex-hooks.json:\n\n' ;;
    *)      tt_die "usage: tt hooks-snippet [claude|codex]" ;;
  esac
  for evt in $events; do
    printf '  %s -> %s\n' "$evt" "$cmd"
  done
  printf '\nWhen no plugin root is exported, replace it with the absolute path to bin/tt.\n'
}

cmd_help() {
  if [ "${1:-}" = report ]; then
    cmd_report_help
    return 0
  fi
  cat <<'USAGE'
tt — per-project time tracking

Time with an agent is recorded automatically by harness hooks; these
commands cover everything else.

RECORD
  add PROJECT DURATION [NOTE] [--at 'YYYY-MM-DD HH:MM']
      Time away from any agent. Duration is 90m, 1.5h, 2h30m or bare
      minutes. --at sets the start and the duration runs forward from it.
      Quote a note longer than one word.
  solo [PATH] [--session ID|--all-sessions]
      Explicitly mark agent activity below PATH as unattended. The default
      uses the current in-session shell id when available, otherwise all
      matching sessions. The flags override that scope.
  paired [PATH] [--session ID|--all-sessions]
      Explicitly mark your return. Mode stays unchanged until this command.

READ
  root               print the configured project root
  report [today|yesterday|week|month] [--since D] [--until D]
         [--by project|day] [--detail]
      Time per project, covering today unless given a period. Run
      'tt report --help' for every period and option.
  sessions           path/session scopes whose mode is set, and their modes

OTHER MACHINES
  sync pull HOST         fetch HOST's log into this machine's repo
  install-remote HOST    clone this tool onto HOST over SSH and name it

SETUP
  init                          create ~/.timetrack
  hooks-snippet [claude|codex]  print hook config for a hand-set-up machine

EXAMPLES
  tt add sportx 90m "architecture review"
  tt add tuurny 2h --at '2026-09-01 14:00'
  tt solo                     # current harness session, or all from your shell
  tt solo --session abc123    # explicitly only that session below $PWD
  tt solo --all-sessions      # explicitly every session below $PWD
  tt paired                   # back and working alongside the agent
  tt report week --detail

PATH defaults to the current directory. Harnesses call `tt hook`; you don't.
USAGE
}

sub=${1:-help}
[ $# -gt 0 ] && shift
case "$sub" in
  init)          cmd_init "$@" ;;
  hook)          (cmd_hook) || true; exit 0 ;;
  add)           cmd_add "$@" ;;
  help|-h|--help) cmd_help "$@" ;;
  root)          tt_root ;;
  solo)          cmd_mode solo "$@" ;;
  paired)        cmd_mode paired "$@" ;;
  sessions)      cmd_sessions ;;
  report)        cmd_report "$@" ;;
  sync)          cmd_sync "$@" ;;
  install-remote) cmd_install_remote "$@" ;;
  hooks-snippet)  cmd_hooks_snippet "$@" ;;
  debug-home)    tt_home ;;
  debug-root)    tt_root ;;
  debug-now)     tt_now ;;
  debug-machine) tt_machine ;;
  debug-seconds) tt_seconds "$1" || exit 1 ;;
  debug-epoch)   tt_epoch "$1" ;;
  debug-iso)     tt_iso "$1" ;;
  debug-midnight) tt_midnight "$(tt_now)" ;;
  debug-attribute) tt_attribute "$1" ;;
  debug-mode)    tt_mode "$1" "${2:--}" ;;
  *)             printf 'tt: unknown subcommand: %s\n' "$sub" >&2; exit 2 ;;
esac
